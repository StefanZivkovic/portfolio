---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Stefan Zivkovic" description="Page not found.">
  <nav class="mb-12">
    <a
      href="/"
      class="font-mono text-sm transition-colors"
      style="color: var(--color-muted)"
      onmouseover="this.style.color='var(--color-text)'"
      onmouseout="this.style.color='var(--color-muted)'"
    >
      ← back home
    </a>
  </nav>

  <div>
    <p class="font-mono text-sm" style="color: var(--color-accent)">404</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-3 text-sm" style="color: var(--color-muted)">
      The page you're looking for doesn't exist or has been moved.
    </p>
  </div>
</Layout>
