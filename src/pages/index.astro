---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);

const posts = await Promise.all(
  allPosts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    const wordCount = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
    const readingTime = Math.max(1, Math.round(wordCount / 200));
    return { ...post, readingTime };
  }),
);

posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Layout title="Stefan Zivkovic">
  <header class="mb-16">
    <div class="flex items-center justify-between">
      <p class="font-mono text-sm" style="color: var(--color-accent)">
        stefanzivkovic.dev
      </p>
      <div class="flex items-center gap-4">
        <a
          href="/qr"
          aria-label="QR code"
          class="transition-colors"
          style="color: var(--color-muted)"
          onmouseover="this.style.color='var(--color-text)'"
          onmouseout="this.style.color='var(--color-muted)'"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="5" height="5" x="3" y="3" rx="1"></rect><rect
              width="5"
              height="5"
              x="16"
              y="3"
              rx="1"></rect><rect width="5" height="5" x="3" y="16" rx="1"
            ></rect><path d="M21 16h-3a2 2 0 0 0-2 2v3"></path><path
              d="M21 21v.01"></path><path d="M12 7v3a2 2 0 0 1-2 2H7"
            ></path><path d="M3 12h.01"></path><path d="M12 3h.01"></path><path
              d="M12 16v.01"></path><path d="M16 12h1"></path><path
              d="M21 12v.01"></path><path d="M12 21v-1"></path>
          </svg>
        </a>
        <a
          href="/search"
          class="flex items-center gap-1.5 font-mono text-xs transition-colors"
          style="color: var(--color-muted)"
          onmouseover="this.style.color='var(--color-text)'"
          onmouseout="this.style.color='var(--color-muted)'"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"
            ></path>
          </svg>
          search
        </a>
      </div>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">
        Stefan Zivkovic
      </h1>
      <p class="mt-2 text-sm" style="color: var(--color-muted)">
        Software engineer. Writing about code, systems, and whatever else seems
        worth exploring.
      </p>
    </div>

    <div class="mb-6 flex flex-wrap gap-2">
      <button
        data-tag-filter="all"
        class="tag-filter active rounded px-2 py-0.5 font-mono text-xs transition-colors"
        style="background-color: var(--color-accent); color: #fff; border: 1px solid var(--color-accent)"
      >
        all
      </button>
      {
        allTags.map((tag) => (
          <button
            data-tag-filter={tag}
            class="tag-filter rounded px-2 py-0.5 font-mono text-xs transition-colors"
            style="background-color: var(--color-bg); color: var(--color-muted); border: 1px solid var(--color-border)"
          >
            #{tag}
          </button>
        ))
      }
    </div>

    <ul class="space-y-3" id="post-list">
      {
        posts.map((post) => (
          <li data-tags={post.data.tags.join(",")}>
            <a
              href={`/posts/${post.id}`}
              class="group block rounded-lg p-5 transition-colors"
              style="background-color: var(--color-surface); border: 1px solid var(--color-border);"
              onmouseover="this.style.borderColor='var(--color-accent)'"
              onmouseout="this.style.borderColor='var(--color-border)'"
            >
              <div class="flex items-start justify-between gap-4">
                <h2 class="leading-snug font-medium">{post.data.title}</h2>
                <div
                  class="flex gap-3 font-mono text-xs whitespace-nowrap"
                  style="color: var(--color-muted)"
                >
                  <span>{post.readingTime} min read</span>
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                </div>
              </div>
              <ul class="mt-3 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <li
                    class="rounded px-2 py-0.5 font-mono text-xs"
                    style="background-color: var(--color-bg); color: var(--color-muted); border: 1px solid var(--color-border)"
                  >
                    #{tag}
                  </li>
                ))}
              </ul>
            </a>
          </li>
        ))
      }
    </ul>
  </header>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".tag-filter");
    const items = document.querySelectorAll<HTMLLIElement>("#post-list > li");

    function setActive(tag: string) {
      buttons.forEach((btn) => {
        const isActive = btn.dataset.tagFilter === tag;
        btn.style.backgroundColor = isActive
          ? "var(--color-accent)"
          : "var(--color-bg)";
        btn.style.color = isActive ? "#fff" : "var(--color-muted)";
        btn.style.borderColor = isActive
          ? "var(--color-accent)"
          : "var(--color-border)";
      });

      items.forEach((item) => {
        const tags = item.dataset.tags?.split(",") ?? [];
        item.style.display = tag === "all" || tags.includes(tag) ? "" : "none";
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        setActive(btn.dataset.tagFilter ?? "all");
      });
    });
  </script>
</Layout>
