---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);

const posts = await Promise.all(
  allPosts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    const wordCount = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
    const readingTime = Math.max(1, Math.round(wordCount / 200));
    return { ...post, readingTime };
  }),
);

posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Layout title="Stefan Zivkovic">
  <header class="mb-16">
    <p class="font-mono text-sm" style="color: var(--color-accent)">
      stefanzivkovic.dev
    </p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">Stefan Zivkovic</h1>
    <p class="mt-2 text-sm" style="color: var(--color-muted)">
      Software engineer. Writing about code, systems, and whatever else seems
      worth exploring.
    </p>
  </header>

  <div class="mb-6 flex flex-wrap gap-2">
    <button
      data-tag-filter="all"
      class="tag-filter font-mono text-xs px-2 py-0.5 rounded transition-colors active"
      style="background-color: var(--color-accent); color: #fff; border: 1px solid var(--color-accent)"
    >
      all
    </button>
    {
      allTags.map((tag) => (
        <button
          data-tag-filter={tag}
          class="tag-filter font-mono text-xs px-2 py-0.5 rounded transition-colors"
          style="background-color: var(--color-bg); color: var(--color-muted); border: 1px solid var(--color-border)"
        >
          #{tag}
        </button>
      ))
    }
  </div>

  <ul class="space-y-3" id="post-list">
    {
      posts.map((post) => (
        <li data-tags={post.data.tags.join(",")}>
          <a
            href={`/posts/${post.id}`}
            class="group block rounded-lg p-5 transition-colors"
            style="background-color: var(--color-surface); border: 1px solid var(--color-border);"
            onmouseover="this.style.borderColor='var(--color-accent)'"
            onmouseout="this.style.borderColor='var(--color-border)'"
          >
            <div class="flex items-start justify-between gap-4">
              <h2 class="font-medium leading-snug">{post.data.title}</h2>
              <div
                class="font-mono text-xs whitespace-nowrap flex gap-3"
                style="color: var(--color-muted)"
              >
                <span>{post.readingTime} min read</span>
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
              </div>
            </div>
            <ul class="mt-3 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <li
                  class="font-mono text-xs px-2 py-0.5 rounded"
                  style="background-color: var(--color-bg); color: var(--color-muted); border: 1px solid var(--color-border)"
                >
                  #{tag}
                </li>
              ))}
            </ul>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".tag-filter");
  const items = document.querySelectorAll<HTMLLIElement>("#post-list > li");

  function setActive(tag: string) {
    buttons.forEach((btn) => {
      const isActive = btn.dataset.tagFilter === tag;
      btn.style.backgroundColor = isActive
        ? "var(--color-accent)"
        : "var(--color-bg)";
      btn.style.color = isActive ? "#fff" : "var(--color-muted)";
      btn.style.borderColor = isActive
        ? "var(--color-accent)"
        : "var(--color-border)";
    });

    items.forEach((item) => {
      const tags = item.dataset.tags?.split(",") ?? [];
      item.style.display =
        tag === "all" || tags.includes(tag) ? "" : "none";
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      setActive(btn.dataset.tagFilter ?? "all");
    });
  });
</script>
