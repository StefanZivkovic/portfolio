---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { readingTime } from "../utils/readingTime";
import { deduplicateTags } from "../utils/tags";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);

const posts = await Promise.all(
  allPosts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    return { ...post, readingTime: readingTime(post.body) };
  }),
);

posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = deduplicateTags(posts.map((p) => p.data.tags));
---

<Layout title="Stefan Zivkovic">
  <header class="mb-16">
    <div class="flex items-center justify-between">
      <p class="font-mono text-sm" style="color: var(--color-accent)">
        stefanzivkovic.dev
      </p>
      <div class="flex items-center gap-4">
        <a
          href="/search"
          aria-label="Search"
          class="transition-colors"
          style="color: var(--color-muted)"
          onmouseover="this.style.color='var(--color-text)'"
          onmouseout="this.style.color='var(--color-muted)'"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"
            ></path>
          </svg>
        </a>
        <button
          id="nav-toggle"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="nav-overlay"
          class="transition-colors"
          style="color: var(--color-muted); background: none; border: none; cursor: pointer; padding: 0;"
          onmouseover="this.style.color='var(--color-text)'"
          onmouseout="this.style.color='var(--color-muted)'"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
    <h1 class="mt-4 text-2xl font-semibold tracking-tight">Stefan Zivkovic</h1>
    <p class="mt-2 text-sm" style="color: var(--color-muted)">
      Software engineer. Writing about code, systems, and whatever else seems
      worth exploring.
    </p>
  </header>

  <div class="mb-6 flex flex-wrap gap-2">
    <button
      data-tag-filter="all"
      class="tag-filter active rounded px-2 py-0.5 font-mono text-xs transition-colors"
      style="background-color: var(--color-accent); color: #fff; border: 1px solid var(--color-accent)"
    >
      all
    </button>
    {
      allTags.map((tag) => (
        <button
          data-tag-filter={tag}
          class="tag-filter rounded px-2 py-0.5 font-mono text-xs transition-colors"
          style="background-color: var(--color-bg); color: var(--color-muted); border: 1px solid var(--color-border)"
        >
          #{tag}
        </button>
      ))
    }
  </div>

  <ul class="space-y-3" id="post-list">
    {
      posts.map((post) => (
        <li data-tags={post.data.tags.join(",")}>
          <a
            href={`/posts/${post.id}`}
            class="group block rounded-lg p-5 transition-colors"
            style="background-color: var(--color-surface); border: 1px solid var(--color-border);"
            onmouseover="this.style.borderColor='var(--color-accent)'"
            onmouseout="this.style.borderColor='var(--color-border)'"
          >
            <div class="flex items-start justify-between gap-4">
              <h2 class="leading-snug font-medium">{post.data.title}</h2>
              <div
                class="flex gap-3 font-mono text-xs whitespace-nowrap"
                style="color: var(--color-muted)"
              >
                <span>{post.readingTime} min read</span>
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
              </div>
            </div>
            <ul class="mt-3 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <li
                  class="rounded px-2 py-0.5 font-mono text-xs"
                  style="background-color: var(--color-bg); color: var(--color-muted); border: 1px solid var(--color-border)"
                >
                  #{tag}
                </li>
              ))}
            </ul>
          </a>
        </li>
      ))
    }
  </ul>

  <!-- Nav overlay -->
  <div
    id="nav-overlay"
    class="fixed inset-0 z-50 hidden"
    style="background-color: var(--color-bg);"
  >
    <div class="mx-auto max-w-2xl px-6 py-16">
      <div class="flex items-center justify-between">
        <p class="font-mono text-sm" style="color: var(--color-accent)">
          stefanzivkovic.dev
        </p>
        <button
          id="nav-close"
          aria-label="Close navigation"
          class="transition-colors"
          style="color: var(--color-muted); background: none; border: none; cursor: pointer; padding: 0;"
          onmouseover="this.style.color='var(--color-text)'"
          onmouseout="this.style.color='var(--color-muted)'"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
      <nav class="mt-16 flex flex-col gap-6">
        <a
          href="/"
          class="font-mono text-2xl font-semibold tracking-tight transition-colors"
          style="color: var(--color-text)"
          onmouseover="this.style.color='var(--color-accent)'"
          onmouseout="this.style.color='var(--color-text)'"
        >
          home
        </a>
        <a
          href="/about"
          class="font-mono text-2xl font-semibold tracking-tight transition-colors"
          style="color: var(--color-text)"
          onmouseover="this.style.color='var(--color-accent)'"
          onmouseout="this.style.color='var(--color-text)'"
        >
          about
        </a>
        <a
          href="/search"
          class="font-mono text-2xl font-semibold tracking-tight transition-colors"
          style="color: var(--color-text)"
          onmouseover="this.style.color='var(--color-accent)'"
          onmouseout="this.style.color='var(--color-text)'"
        >
          search
        </a>
      </nav>
    </div>
  </div>

  <script>
    // Tag filter
    const buttons = document.querySelectorAll<HTMLButtonElement>(".tag-filter");
    const items = document.querySelectorAll<HTMLLIElement>("#post-list > li");

    function applyFilter(tag: string) {
      buttons.forEach((btn) => {
        const isActive = btn.dataset.tagFilter === tag;
        btn.style.backgroundColor = isActive
          ? "var(--color-accent)"
          : "var(--color-bg)";
        btn.style.color = isActive ? "#fff" : "var(--color-muted)";
        btn.style.borderColor = isActive
          ? "var(--color-accent)"
          : "var(--color-border)";
      });

      items.forEach((item) => {
        const tags = item.dataset.tags?.split(",") ?? [];
        item.style.display = tag === "all" || tags.includes(tag) ? "" : "none";
      });
    }

    function setActive(tag: string) {
      applyFilter(tag);
      const url = new URL(window.location.href);
      if (tag === "all") {
        url.searchParams.delete("tag");
      } else {
        url.searchParams.set("tag", tag);
      }
      history.pushState(null, "", url);
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        setActive(btn.dataset.tagFilter ?? "all");
      });
    });

    // Restore tag from URL on load
    const initialTag =
      new URLSearchParams(window.location.search).get("tag") ?? "all";
    applyFilter(initialTag);

    // Nav menu
    const overlay = document.getElementById("nav-overlay")!;
    const navToggle = document.getElementById("nav-toggle")!;

    function openNav() {
      overlay.classList.remove("hidden");
      navToggle.setAttribute("aria-expanded", "true");
    }

    function closeNav() {
      overlay.classList.add("hidden");
      navToggle.setAttribute("aria-expanded", "false");
      navToggle.focus();
    }

    navToggle.addEventListener("click", openNav);
    document.getElementById("nav-close")!.addEventListener("click", closeNav);
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeNav();
    });
  </script>
</Layout>
