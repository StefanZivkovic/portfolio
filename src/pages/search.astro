---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Search — Stefan Zivkovic">
  <header class="mb-10">
    <a
      href="/"
      class="font-mono text-sm transition-colors"
      style="color: var(--color-muted)"
      onmouseover="this.style.color='var(--color-text)'"
      onmouseout="this.style.color='var(--color-muted)'"
    >
      ← back
    </a>
    <div class="mt-8 flex items-center gap-3 rounded-lg px-4 py-3" style="background-color: var(--color-surface); border: 1px solid var(--color-border);">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-muted); flex-shrink: 0;">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Search posts..."
        autofocus
        class="w-full bg-transparent outline-none text-sm"
        style="color: var(--color-text); caret-color: var(--color-accent);"
      />
    </div>
  </header>

  <div id="search"></div>
</Layout>

<style is:global>
  .pagefind-ui__form {
    display: none !important;
  }
</style>

<script is:inline>
  const script = document.createElement("script");
  script.src = "/pagefind/pagefind-ui.js";
  script.onload = () => {
    const ui = new PagefindUI({
      element: "#search",
      showSubResults: false,
      resetStyles: true,
    });

    const customInput = document.getElementById("search-input");
    customInput.addEventListener("input", () => {
      const pagefindInput = document.querySelector(".pagefind-ui__search-input");
      if (pagefindInput) {
        const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, "value").set;
        nativeInputValueSetter.call(pagefindInput, customInput.value);
        pagefindInput.dispatchEvent(new Event("input", { bubbles: true }));
      }
    });
  };
  script.onerror = () => {
    const el = document.getElementById("search");
    if (el)
      el.innerHTML =
        '<p style="color:var(--color-muted);font-size:0.875rem">Search index not available in dev mode. Run <code style="font-family:monospace">npm run build && npm run preview</code> to test search.</p>';
  };
  document.head.appendChild(script);
</script>
